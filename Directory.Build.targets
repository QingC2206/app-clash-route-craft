<Project>
  <!-- Older installed SDKs otherwise publish the vulnerable Brotli runtime.
       Keep newer SDK pack versions; only raise the .NET 10 AOT security floor.
       https://github.com/advisories/GHSA-p3jp-9v83-76w9 -->
  <Target Name="ClashRouteCraftAotSecurityFloor" BeforeTargets="ProcessFrameworkReferences" Condition="'$(PublishAot)' == 'true'">
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler"
                         Condition="'%(KnownILCompilerPack.TargetFramework)' == 'net10.0' and $([MSBuild]::VersionLessThan('%(KnownILCompilerPack.ILCompilerPackVersion)', '10.0.14'))">
      <ILCompilerPackVersion>10.0.14</ILCompilerPackVersion>
    </KnownILCompilerPack>
    <KnownFrameworkReference Update="Microsoft.NETCore.App"
                             Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net10.0' and $([MSBuild]::VersionLessThan('%(KnownFrameworkReference.LatestRuntimeFrameworkVersion)', '10.0.14'))">
      <DefaultRuntimeFrameworkVersion>10.0.14</DefaultRuntimeFrameworkVersion>
      <LatestRuntimeFrameworkVersion>10.0.14</LatestRuntimeFrameworkVersion>
    </KnownFrameworkReference>
  </ItemGroup>
  </Target>
</Project>
